# Upstash / Vercel KV REST credentials
# The API supports either UPSTASH_* or Vercel-managed KV_* names.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Preferred private key for the hidden score-control page.
# Create this manually in Vercel and enable it for Production.
# It overrides SCORE_ADMIN_KEY if both exist.
# Use a long random value and never expose it as VITE_*.
WBY_ADMIN_KEY=

# Legacy fallback only.
SCORE_ADMIN_KEY=
